---
import BaseLayout from "../layouts/BaseLayout.astro";
const user = { name: "Jimmy", email: "jimbo@gmail.com" };
---

<BaseLayout>
  <div class="content">
    <h2>Welcome, {user.name}</h2>
    <p>Logged in as: {user.email}</p>

    <p>
      Lorem ipsum dolor sit amet consectetur, adipisicing elit. Minima sapiente
      accusamus possimus veniam pariatur dolores numquam repellat? Deleniti
      laborum, ducimus tenetur molestias, voluptate exercitationem tempore qui
      blanditiis ab, natus officia!
    </p>
    <a href="/books">Take a look at my reviews</a>
  </div>
</BaseLayout>

<style>
  .content {
    text-align: center;
  }
  a {
    display: inline-block;
    background-color: #7a49c5;
    color: white;
    padding: 6px 10px;
    border-radius: 2px;
    text-decoration: none;
    margin-top: 20px;
  }
  a:hover {
    background-color: #965ee9;
  }
</style>
